# LOCAL DEVELOPMENT / DEMONSTRATION ONLY.
# Copy to .env for local overrides. .env is gitignored.
# These values are fake throwaway credentials, not production secrets.

ASPNETCORE_ENVIRONMENT=Development
Authentication__Authority=http://localhost:8080/realms/customer-api-demo
Authentication__Audience=customer-api
Authentication__RequireHttpsMetadata=false

# Keycloak start-dev admin (local only)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Confidential client used by scripts/keycloak-smoke-test.sh
# Must match infra/keycloak/realm-export.json for a fresh local import.
CUSTOMER_A_INTEGRATION_CLIENT_ID=customer-a-integration
CUSTOMER_A_INTEGRATION_SECRET=local-only-integration-secret
