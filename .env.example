# Copy to .env for local overrides. .env is gitignored.
# These values are fake local-development settings.

ASPNETCORE_ENVIRONMENT=Development
Authentication__Authority=http://localhost:8080/realms/customer-platform
Authentication__Audience=customer-api

# Keycloak start-dev admin (local only, not a production secret)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
